<Template>

  <WidgetGroup>
    <Layout>vertical</Layout>
    <MaximumSize>,230</MaximumSize>
    <Children>

      <!-- Active-deck bar: indicates the active deck (color from `focus`) and
           selects this deck when clicked (writes to `focus_request`). -->
      <PushButton>
        <ObjectName>DeckFocusBar</ObjectName>
        <Size>0e,18f</Size>
        <NumberStates>2</NumberStates>
        <Text>ACTIVE</Text>
        <Style>
          #DeckFocusBar {
            background-color: #222222;
            border: none;
            color: #777777;
            font: bold 9px;
            qproperty-alignment: 'AlignCenter';
          }
          #DeckFocusBar[value="1"] {
            background-color: #ff9d00;
            color: #1a1a1a;
          }
        </Style>
        <Connection>
          <ConfigKey>[Channel<Variable name="ChanNum"/>],focus_request</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
          <ConnectValueToWidget>false</ConnectValueToWidget>
        </Connection>
        <Connection>
          <ConfigKey>[Channel<Variable name="ChanNum"/>],focus</ConfigKey>
          <ConnectValueFromWidget>false</ConnectValueFromWidget>
        </Connection>
      </PushButton>

      <Template src="skins:LateNight/decks/deck_singletons.xml">
        <SetVariable name="Type">deck</SetVariable>
        <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
      </Template>

      <!-- Frame around the deck, colored when this deck is active. -->
      <WidgetGroup>
        <ObjectName>DeckBorder</ObjectName>
        <Layout>vertical</Layout>
        <Style>
          #DeckBorderEdge { background-color: transparent; }
          #DeckBorderEdge[highlight="1"] { background-color: #ff9d00; }
        </Style>
        <Children>

          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>

              <WidgetGroup>
                <ObjectName>DeckBorderEdge</ObjectName>
                <Size>2f,0me</Size>
                <Connection>
                  <ConfigKey>[Channel<Variable name="ChanNum"/>],focus</ConfigKey>
                  <BindProperty>highlight</BindProperty>
                </Connection>
              </WidgetGroup>

              <WidgetStack currentpage="[Skin],show_mixer" persist="true">
        <Children>

          <!-- no mixer -->
          <WidgetStack currentpage="[LateNight],deck_size_without_mixer" persist="true">
            <Children>
              <!-- minimal deck selected -->
              <WidgetGroup trigger="[LateNight],show_mini_deck">
                <Layout>horizontal</Layout>
                <Children>
                  <SingletonContainer>
                    <ObjectName>Deck<Variable name="ChanNum"/>_Mini</ObjectName>
                  </SingletonContainer>
                </Children>
              </WidgetGroup>
              <!-- Compact deck selected -->
              <WidgetGroup trigger="[LateNight],show_compact_deck">
                <Layout>horizontal</Layout>
                <Children>
                <SingletonContainer>
                  <ObjectName>Deck<Variable name="ChanNum"/>_Compact</ObjectName>
                </SingletonContainer>
                </Children>
              </WidgetGroup>
              <!-- Full deck selected -->
              <WidgetGroup trigger="[LateNight],show_full_deck">
                <Layout>horizontal</Layout>
                <Children>
                  <SingletonContainer>
                    <ObjectName>Deck<Variable name="ChanNum"/>_Full</ObjectName>
                  </SingletonContainer>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetStack>

          <!-- mixer shown = full deck -->
          <WidgetGroup trigger="[Skin],show_mixer" on_hide_select="0">
            <Layout>horizontal</Layout>
            <Children>
              <SingletonContainer>
                <ObjectName>Deck<Variable name="ChanNum"/>_Full</ObjectName>
              </SingletonContainer>
            </Children>
          </WidgetGroup>

        </Children>
              </WidgetStack>

              <WidgetGroup>
                <ObjectName>DeckBorderEdge</ObjectName>
                <Size>2f,0me</Size>
                <Connection>
                  <ConfigKey>[Channel<Variable name="ChanNum"/>],focus</ConfigKey>
                  <BindProperty>highlight</BindProperty>
                </Connection>
              </WidgetGroup>

            </Children>
          </WidgetGroup>

          <WidgetGroup>
            <ObjectName>DeckBorderEdge</ObjectName>
            <Size>0me,2f</Size>
            <Connection>
              <ConfigKey>[Channel<Variable name="ChanNum"/>],focus</ConfigKey>
              <BindProperty>highlight</BindProperty>
            </Connection>
          </WidgetGroup>

        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
